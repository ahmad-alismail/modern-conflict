; Engine configuration file.
; Modern Conflict - modern warfare RTS with tactical pause.

config_version=5

[application]

config/name="Modern Conflict"
config/description="Modern warfare real-time strategy with tactical pause."
config/version="1.0.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.06, 0.07, 0.06, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://src/core/settings.gd"
Events="*res://src/core/events.gd"
DevHarness="*res://src/core/dev_harness.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[gui]

common/snap_controls_to_pixels=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.6, 0.66, 1)
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
